[Unit]
Description=Run Garmin Agent Sync container
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=garmin-sync
Group=garmin-sync
WorkingDirectory=/opt/garmin-agent-sync
Environment=GOOGLE_SHEETS_CREDENTIALS=/etc/garmin-agent-sync/google.json
ExecStart=/usr/bin/docker compose run --rm sync sync
NoNewPrivileges=true
PrivateTmp=true
