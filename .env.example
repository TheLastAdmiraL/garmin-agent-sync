# Copy to .env; this file contains configuration names/placeholders only.
GARMIN_SHEET_ID=YOUR_SPREADSHEET_ID
GARMIN_BACKFILL_START=YYYY-MM-DD
GARMIN_BACKFILL_BATCH_DAYS=7
GARMIN_REFRESH_DAYS=3

# Docker only: set these to `id -u garmin-sync` and `id -g garmin-sync` on Linux.
SYNC_UID=10001
SYNC_GID=10001

# Optional path to a protected Google service-account JSON credential file.
# Prefer workload identity or ADC when available; never commit the credential.
# GOOGLE_APPLICATION_CREDENTIALS=C:\\private\\google-sheets-service-account.json
